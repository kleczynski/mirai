{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 88,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "singleAttributePerLine": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    ".wrangler/**",
    "outputs/**",
    ".sites-runtime/**"
  ]
}
